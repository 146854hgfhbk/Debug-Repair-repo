# Required repair model settings. The endpoint must implement the OpenAI chat
# completions API. Do not commit the populated .env file.
DEBUGREPAIR_LLM_LABEL=paper-backbone
DEBUGREPAIR_LLM_BASE_URL=https://provider.example/v1
DEBUGREPAIR_LLM_MODEL=replace-with-model-id
DEBUGREPAIR_LLM_API_KEY=replace-with-api-key
DEBUGREPAIR_LLM_TEMPERATURE=1.0

# Local Defects4J 2.0 executable and conservative default concurrency.
DEBUGREPAIR_DEFECTS4J=/absolute/path/to/defects4j/framework/bin/defects4j
DEBUGREPAIR_BUG_WORKERS=1
DEBUGREPAIR_LLM_TIMEOUT=120

# Optional: use a separate instrumentation model. When these are omitted,
# instrumentation uses the repair endpoint, model, and key above.
# DEBUGREPAIR_INSTRUMENT_LLM_PROVIDER=openai
# DEBUGREPAIR_INSTRUMENT_LLM_BASE_URL=https://provider.example/v1
# DEBUGREPAIR_INSTRUMENT_LLM_MODEL=replace-with-instrumentation-model-id
# DEBUGREPAIR_INSTRUMENT_LLM_API_KEY=replace-with-instrumentation-api-key
# DEBUGREPAIR_INSTRUMENT_LLM_REASONING_EFFORT=high

# Optional: delegate compilation, tests, and trace collection to a validator.
# DEBUGREPAIR_VALIDATOR_URL=https://validator.example
# DEBUGREPAIR_VALIDATOR_TOKEN=replace-with-validator-token
